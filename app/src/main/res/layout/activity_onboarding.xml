<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sonju_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/tutorialStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/sonju_text_secondary"
        android:textSize="15sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/content_description_logo"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher_round" />

    <TextView
        android:id="@+id/tutorialTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:textColor="@color/sonju_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tutorialBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/sonju_text"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/tutorialDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@color/sonju_surface"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="18dp"
        android:textColor="@color/sonju_text_secondary"
        android:textSize="16sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tutorialPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/sonju_green"
        app:cornerRadius="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tutorialSecondaryButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:textAllCaps="false"
        android:textColor="@color/sonju_green"
        android:textSize="16sp"
        android:text="@string/tutorial_previous" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tutorialAppInfoButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/tutorial_app_info_action"
        android:textAllCaps="false"
        android:textColor="@color/sonju_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
