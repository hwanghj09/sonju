<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_voice_command_panel"
    android:elevation="16dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_voice_title"
        android:textColor="@color/sonju_green"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/liveTranscript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="56dp"
        android:text="@string/live_voice_ready"
        android:textColor="@color/sonju_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cancelVoiceCommand"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:text="@string/confirm_cancel"
        android:textColor="@color/sonju_green"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
